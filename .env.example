# Copy to .env for local development. Never commit real values.

# Google AI Studio key (https://aistudio.google.com/apikey). Optional: without it,
# LabLink runs with deterministic fallbacks instead of Gemini.
GEMINI_API_KEY=

# Gemini model id, or 'auto' to pick the newest available Flash model.
GEMINI_MODEL=auto

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Campus timezone offset from UTC in minutes (IST = 330).
CAMPUS_UTC_OFFSET_MINUTES=330

PORT=8080
